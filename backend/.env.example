# ==============================================================================
# SMART AGRICULTURAL DRAINAGE SYSTEM - FASTAPI BACKEND CONFIGURATION
# ==============================================================================

# Server Environment
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 1. AI ADVISORY & REASONING (Google Gemini API)
# ------------------------------------------------------------------------------
# Ingests elevation grids, local sinks, soil types, and A* ditch routes to produce
# plain-text agronomic recommendations and ICAR-aligned drainage engineering plans.
# Provision at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. WEATHER & PRECIPITATION API (OpenWeatherMap or Tomorrow.io)
# ------------------------------------------------------------------------------
# Fetches real-time localized rainfall depth (mm), 24h precipitation forecasts,
# and monsoon intensity for dynamic SCS Curve Number (SCS-CN) runoff simulations.
# Option A - OpenWeatherMap (https://openweathermap.org/api):
OPENWEATHER_API_KEY=your_openweather_api_key_here
# Option B - Tomorrow.io (https://www.tomorrow.io/weather-api/):
TOMORROW_IO_API_KEY=your_tomorrow_io_api_key_here

# ------------------------------------------------------------------------------
# 3. HIGH-RESOLUTION ELEVATION DATA (Google Maps or Mapbox Terrain-RGB)
# ------------------------------------------------------------------------------
# Provides sub-meter digital elevation models (DEM) for precision micro-topography.
# Note: If left blank, the system automatically falls back to free Open-Meteo SRTM/Copernicus (30m).
# Option A - Google Maps Elevation API (https://console.cloud.google.com/):
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Option B - Mapbox Terrain-RGB API (https://account.mapbox.com/):
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# ------------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE (Optional / SQLite / PostgreSQL PostGIS)
# ------------------------------------------------------------------------------
# Stores user-drawn farm boundaries, computed hydrology zones, and ditch trajectories.
# Default uses local zero-config SQLite. For production with PostGIS, use postgresql://...
DATABASE_URL=sqlite:///./drainage_system.db

# ------------------------------------------------------------------------------
# 5. ALGORITHM & SIMULATION TUNING
# ------------------------------------------------------------------------------
DEFAULT_GRID_RESOLUTION=20
MAX_GRID_RESOLUTION=45
DEFAULT_SOIL_TYPE=clay
DEFAULT_RAINFALL_EVENT_MM=65.0
