# ==============================================================================
# SMART AGRICULTURAL DRAINAGE SYSTEM - NEXT.JS FRONTEND CONFIGURATION
# ==============================================================================

# Backend API Endpoint
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# ------------------------------------------------------------------------------
# 1. BASE MAP & GEOCODING PROVIDERS
# ------------------------------------------------------------------------------
# Mapbox Access Token (Optional): Enables high-resolution Mapbox Satellite,
# Streets, and Mapbox Places Geocoding Search.
# Note: If left blank, the app seamlessly defaults to free Esri World Imagery,
# CartoDB Dark Matter, OpenStreetMap, and OpenStreetMap Nominatim geocoding.
# Provision at: https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here

# Google Maps JavaScript API Key (Optional):
# Provision at: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# ------------------------------------------------------------------------------
# 2. APPLICATION METADATA & TELEMETRY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Smart Agricultural Drainage System"
NEXT_PUBLIC_RESEARCHER_NAME="Rakesh Bangra (UEM Jaipur)"
NEXT_PUBLIC_ENABLE_3D_VIEWER=true

